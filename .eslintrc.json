{
  "env": {
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "no-console": "off",
    "linebreak-style": "off",
    "camelcase": "off",
    "no-restricted-syntax": "off",
    "no-await-in-loop": "off",
    "global-require": "off",
    "no-shadow": "off",
    "max-len": "off",
    "import/no-extraneous-dependencies": "off",
    "no-unused-vars": ["error", { "args": "none" }]
  }
}
